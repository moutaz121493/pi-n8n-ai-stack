# Copy to .env and replace all placeholder values before starting.
# Generate a 32-byte encryption key: openssl rand -hex 32

TZ=Europe/Berlin
N8N_BIND_HOST=127.0.0.1
N8N_PORT=5678
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
N8N_WORKER_CONCURRENCY=4
EXECUTIONS_DATA_MAX_AGE=168

# Postgres (used by docker-compose.yml queue mode)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=n8n

# Downstream Guarded Agent microservice (optional)
AGENT_SERVICE_URL=http://host.docker.internal:8081

# Optional Cloudflare Tunnel (enable with: docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=
