{
  "name": "01 - AI Webhook Triage & Confidence Router",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-triage",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-intake",
      "name": "Webhook Intake",
      "type": "n8n-nodes-base.webhook",
      "webhookId": "3f6c1b2e-7a41-4c1e-9b8a-a1f0c2d4e601",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.AGENT_SERVICE_URL || 'http://host.docker.internal:8081' }}/v1/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ task: $json.body.message || '', channel: 'webhook', max_steps: 3, max_cost_usd: 0.02 }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "call-guarded-agent",
      "name": "Call Guarded Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "hitl-check",
              "leftValue": "={{ $json.status }}",
              "rightValue": "awaiting_approval",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "route-by-status",
      "name": "Needs Human Approval?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [740, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ routed: 'human_approval', approval_code: $json.approval_code, summary: $json.answer }) }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "respond-approval",
      "name": "Respond: Approval Required",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1000, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ routed: 'auto_resolved', answer: $json.answer, cost_usd: $json.cost_usd }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-ok",
      "name": "Respond: Auto Resolved",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1000, 400]
    }
  ],
  "connections": {
    "Webhook Intake": {
      "main": [
        [
          {
            "node": "Call Guarded Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Guarded Agent": {
      "main": [
        [
          {
            "node": "Needs Human Approval?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs Human Approval?": {
      "main": [
        [
          {
            "node": "Respond: Approval Required",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond: Auto Resolved",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "template"
    },
    {
      "name": "agentic-ai"
    }
  ]
}
